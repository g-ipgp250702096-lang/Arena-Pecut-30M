/*
  Content-Security-Policy: frame-ancestors 'self' https:;
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff

/assets/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/src/assets/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/mediapipe-wasm/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/mediapipe-models/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
